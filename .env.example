# GlintPM Frontend — Environment Variables
# Copy this file to .env and fill in values for local development.
# Never commit real secrets. EXPO_PUBLIC_* variables are embedded in the client bundle.

# API base URL (must end without trailing slash). Points to Django /api/v1.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Optional: app environment label
EXPO_PUBLIC_APP_ENV=development
