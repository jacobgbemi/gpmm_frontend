# GlintPM Mobile — Environment Variables
# Copy this file to .env and fill in values for local development.
# Never commit .env files containing real secrets.
# Only EXPO_PUBLIC_* variables are available in the client bundle.

# API base URL (no trailing slash)
# Development example:
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Production / staging examples (set via EAS secrets or CI):
# EXPO_PUBLIC_API_BASE_URL=https://api.glintpm.com/api/v1
# EXPO_PUBLIC_API_BASE_URL=https://staging-api.glintpm.com/api/v1

# Optional: enable extra logging in development
EXPO_PUBLIC_DEBUG=true

# App environment label (development | staging | production)
EXPO_PUBLIC_APP_ENV=development
